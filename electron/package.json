{
  "name": "tokenhours-live-desktop",
  "productName": "TokenHours Live",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "description": "Desktop wrapper for TOKENHOURS Live — the same meter + True Cost engine, in the tray.",
  "author": "AI Lead Strategies LLC",
  "scripts": {
    "stage": "node stage-app.mjs",
    "start": "npm run stage && electron .",
    "build": "npm run stage && electron-builder",
    "build:win": "npm run stage && electron-builder --win",
    "build:mac": "npm run stage && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.tokenhours.live",
    "productName": "TokenHours Live",
    "asar": false,
    "files": ["main.mjs", "app/**/*", "build/tray.png"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": ["zip"], "icon": "build/icon.png", "artifactName": "TokenHours-Live-win-portable.${ext}" },
    "mac": { "target": "dmg", "icon": "build/icon.png", "category": "public.app-category.developer-tools", "artifactName": "TokenHours-Live.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true }
  }
}
